# Render Payroll API environment template.
# Copy these variable names into the Render service's Environment settings.
# Replace every example URL/value with your deployment's actual values in Render.
# Never commit a populated .env file or put secrets in this template.

NODE_ENV=production
DATABASE_URL=REPLACE_WITH_RENDER_INTERNAL_DATABASE_URL
ALLOWED_ORIGINS=https://your-payroll-app.vercel.app
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=true
TRUST_PROXY=1

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=600

# Attach a Render persistent disk at /var/data before using this path.
STORAGE_DIR=/var/data/storage
LOG_LEVEL=info
PAYSLIP_COMPANY_NAME=Your company name
PAYROLL_RULES_APPROVED=false
PAYSLIP_FORMAT_APPROVED=false
VIEWER_ROLE_ENABLED=false

# Optional: generate a fresh 32-byte base64 key if storing bank account details.
# Keep the same value across deployments; losing it makes stored account numbers unreadable.
BANK_DATA_KEY=

# Configure an email provider before enabling production sign-up or notifications.
SIGNUP_ENABLED=false
SIGNUP_REQUIRE_APPROVAL=true
ADMIN_SIGNUP=off
SIGNUP_ALLOWED_DOMAINS=
MAIL_PROVIDER=
MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NexziByte <no-reply@example.invalid>
