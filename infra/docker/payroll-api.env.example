# Copy to payroll-api.env (never commit the real file). Values for the docker compose stack.
NODE_ENV=production
PORT=4001
DATABASE_URL=postgresql://nexzi_dev:nexzi_dev_only@postgres:5432/payroll?schema=public
# The public HTTPS origin of the payroll web app
ALLOWED_ORIGINS=https://payroll.example.invalid
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=true
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=info
PAYSLIP_COMPANY_NAME=[Client company name]
PAYROLL_RULES_APPROVED=false
PAYSLIP_FORMAT_APPROVED=false
VIEWER_ROLE_ENABLED=false
