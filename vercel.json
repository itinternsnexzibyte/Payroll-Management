{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "payroll-api": {
      "root": "apps/payroll-api",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build -w @nexzi/payroll-api"
    },
    "payroll-web": {
      "root": "apps/payroll-web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run build -w @nexzi/payroll-web"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "payroll-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "payroll-web"
      }
    }
  ]
}
