# ---------------------------------------------------------------------------
# Payroll API — environment configuration. Copy to .env and adjust.
# NEVER commit real credentials. Production values come from the hosting secret store.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4001
# Local development database (npm run db:start, or docker compose up -d postgres)
DATABASE_URL=postgresql://nexzi_dev:nexzi_dev_only@localhost:5433/payroll?schema=public
# Separate database used by integration tests (wiped by the tests)
TEST_DATABASE_URL=postgresql://nexzi_dev:nexzi_dev_only@localhost:5433/payroll_test?schema=public

# Browser origins allowed to make state-changing requests (CSRF origin check)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:4001
# Prefix under which the web app proxies this API (used in OpenAPI "servers")
PUBLIC_API_PREFIX=/api
# Must be true behind HTTPS in production
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Private storage for generated payslip PDFs (must NOT be web-served)
STORAGE_DIR=./storage
# Optional: path to Chrome/Chromium/Edge used for PDF rendering (auto-detected if unset)
# PDF_BROWSER_PATH=
LOG_LEVEL=info
# Proxies in front of the API: a hop count (1, 2) or addresses. Default: loopback only.
# TRUST_PROXY=1

# Company name printed on payslips (fixed content; replace with the client-approved wording)
PAYSLIP_COMPANY_NAME=[Client company name — awaiting approved payslip format]

# Set to true ONLY after the configured components/formulas have been reconciled against the
# client's approved Excel workbook and sample months. While false, every calculated amount is
# labelled PROVISIONAL on screens, payslips and reports.
PAYROLL_RULES_APPROVED=false
# Set to true only after the client has approved a rendered payslip in their own format.
PAYSLIP_FORMAT_APPROVED=false
# 32-byte base64 key that encrypts employee bank account numbers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to have the API generate a key in STORAGE_DIR/keys/bank-data.key on first use
# (back that file up with the storage folder).
BANK_DATA_KEY=

# Separate 32-byte key for encrypting private client identity and MOU documents. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable and back it up securely; losing it makes stored client documents unreadable.
CLIENT_DATA_KEY=

# Optional read-only Viewer/Management role — keep false until the client confirms it.
VIEWER_ROLE_ENABLED=false

# ---- Development seed only (refused when NODE_ENV=production) ----
# Development-only sign-in accounts. Do not reuse these anywhere else. (Avoid "#" in .env values.)
SEED_ADMIN_EMAIL=admin@payroll.local
SEED_ADMIN_PASSWORD=DevAdmin-2026x
SEED_PAYROLL_USER_EMAIL=payroll.user@payroll.local
SEED_PAYROLL_USER_PASSWORD=DevPayroll-2026x
SEED_DEMO_DATA=true

# ---- Self-service sign-up (email -> 6-digit code -> name + password) ----
SIGNUP_ENABLED=true
# Administrator sign-up: "approval" lets people request an Administrator account, which stays
# PENDING until an existing Administrator approves it in Users; "off" hides the option.
ADMIN_SIGNUP=approval
# Optional: only these email domains may sign up, e.g. client.com,example.org (empty = any address)
SIGNUP_ALLOWED_DOMAINS=
# Email delivery. Leave SMTP_HOST empty in development: codes are then saved as files in
# <STORAGE_DIR>/dev-mailbox instead of being sent. Production requires SMTP_HOST (a server
# name such as smtp.gmail.com — not an email address) or MAIL_PROVIDER=brevo|resend + MAIL_API_KEY.
# MAIL_PROVIDER=
# MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NexziByte <no-reply@example.invalid>