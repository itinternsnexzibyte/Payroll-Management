// Payroll Management — database schema (PostgreSQL, database "payroll").
// Money is DECIMAL; never floating point. Finalised payroll rows are protected by DB triggers
// (see migration 0002_integrity_triggers) in addition to application checks.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // native for local development, debian-openssl-3.0.x for the Docker image
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Identity & access

enum UserStatus {
  ACTIVE
  DISABLED
  /// Self-registered, awaiting administrator approval
  PENDING
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  /// Disabled roles cannot sign in (e.g. VIEWER until the client confirms it).
  enabled     Boolean          @default(true)
  isSystem    Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model RolePermission {
  roleId         String @db.Uuid
  permissionCode String
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  name               String
  passwordHash       String
  roleId             String     @db.Uuid
  role               Role       @relation(fields: [roleId], references: [id])
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?    @db.Uuid
  updatedById        String?    @db.Uuid
  sessions           Session[]
  /// Self-service: the employee record this account belongs to (one account per employee)
  employeeId         String?    @unique @db.Uuid
  employee           Employee?  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceEnabled  Boolean    @default(true)

  @@index([roleId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@map("sessions")
}

/// Email verification codes for self-service sign-up (code and token stored hashed).
model EmailVerification {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  consumedAt     DateTime?
  ip             String?
  createdAt      DateTime  @default(now())

  @@index([email, createdAt])
  @@map("email_verifications")
}

/// Append-only (UPDATE/DELETE blocked by trigger).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())
  actorId    String?  @db.Uuid
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?

  @@index([occurredAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- Masters & settings

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  active      Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?    @db.Uuid
  updatedById String?    @db.Uuid

  @@map("departments")
}

model Designation {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  active      Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?    @db.Uuid
  updatedById String?    @db.Uuid

  @@map("designations")
}

/// Key/value business settings (rounding, approval policy, ...). Changes are audit-logged.
model PayrollSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("payroll_settings")
}

// ---------------------------------------------------------------- Employees

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  EXITED
}

model Employee {
  id             String               @id @default(uuid()) @db.Uuid
  /// Business identifier (format to be confirmed with the client)
  employeeCode   String               @unique
  fullName       String
  departmentId   String?              @db.Uuid
  department     Department?          @relation(fields: [departmentId], references: [id])
  designationId  String?              @db.Uuid
  designation    Designation?         @relation(fields: [designationId], references: [id])
  joiningDate    DateTime             @db.Date
  exitDate       DateTime?            @db.Date
  status         EmployeeStatus       @default(ACTIVE)
  /// Contact details (optional)
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?              @db.Uuid
  updatedById    String?              @db.Uuid
  salaryVersions SalaryVersion[]
  runEmployees   PayrollRunEmployee[]
  inputs         PayrollInput[]
  lines          PayrollLine[]
  payslips       Payslip[]
  anomalies      PayrollAnomaly[]
  reconNotes     ReconciliationNote[]
  user           User?
  leaveRequests  LeaveRequest[]
  entitlements   LeaveEntitlement[]
  bankAccount    EmployeeBankAccount?
  loans          Loan[]
  bonuses        BonusEntry[]
  attendanceRecords AttendanceRecord[]
  attendanceWorkSessions AttendanceWorkSession[]
  attendanceAccessRequests AttendanceAccessRequest[]
  workAssignments  WorkAssignment[]
  calendarEvents   CalendarEvent[]
  notifications    EmployeeNotification[]
  workforceProfile EmployeeWorkforceProfile?
  ratings          EmployeeRating[]
  documents        EmployeeDocument[]

  @@index([fullName])
  @@index([status])
  @@index([departmentId])
  @@map("employees")
}

enum AttendanceRecordStatus {
  PRESENT
  ABSENT
  LEAVE
}

model AttendanceRecord {
  id             String                 @id @default(uuid()) @db.Uuid
  employeeId     String                 @db.Uuid
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceDate DateTime               @db.Date
  loginTime      String?                @db.VarChar(5)
  logoutTime     String?                @db.VarChar(5)
  status         AttendanceRecordStatus @default(PRESENT)
  workingMinutes Int?
  createdById    String?                @db.Uuid
  updatedById    String?                @db.Uuid
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  workSessions   AttendanceWorkSession[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("employee_attendance_records")
}

model AttendanceWorkSession {
  id                  String                 @id @default(uuid()) @db.Uuid
  attendanceRecordId  String                 @db.Uuid
  attendanceRecord    AttendanceRecord       @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employeeId          String                 @db.Uuid
  employee            Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startedAt           DateTime
  endedAt             DateTime?
  lastHeartbeatAt     DateTime?
  forcedCheckout      Boolean                @default(false)
  checkoutReason      String?                @db.VarChar(100)
  locationConsent     Boolean                @default(false)
  breaks              AttendanceBreak[]
  locations           AttendanceLocation[]
  accessRequests      AttendanceAccessRequest[]

  @@index([attendanceRecordId, startedAt])
  @@index([employeeId, endedAt])
  @@map("attendance_work_sessions")
}

model AttendanceBreak {
  id        String                @id @default(uuid()) @db.Uuid
  sessionId String                @db.Uuid
  session   AttendanceWorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId, startedAt])
  @@map("attendance_breaks")
}

model AttendanceLocation {
  id                String                @id @default(uuid()) @db.Uuid
  sessionId         String                @db.Uuid
  session           AttendanceWorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  capturedAt        DateTime              @default(now())
  latitude          Decimal               @db.Decimal(10, 7)
  longitude         Decimal               @db.Decimal(10, 7)
  accuracyMeters    Decimal?              @db.Decimal(9, 2)
  distanceFromStart Decimal               @default(0) @db.Decimal(12, 2)
  distanceFromPrev  Decimal               @default(0) @db.Decimal(12, 2)

  @@index([sessionId, capturedAt])
  @@map("attendance_locations")
}

enum AttendanceAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceAccessRequest {
  id          String                          @id @default(uuid()) @db.Uuid
  employeeId  String                          @db.Uuid
  employee    Employee                        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessionId   String?                         @db.Uuid
  session     AttendanceWorkSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reason      String
  status      AttendanceAccessRequestStatus   @default(PENDING)
  reviewedById String?                        @db.Uuid
  createdAt   DateTime                        @default(now())
  reviewedAt  DateTime?

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@map("attendance_access_requests")
}

enum WorkAssignmentStatus {
  OPEN
  CLOSED
}

enum WorkSubmissionStatus {
  SUBMITTED
  NEEDS_CHANGES
  ACCEPTED
}

model WorkAssignment {
  id          String                @id @default(uuid()) @db.Uuid
  employeeId  String                @db.Uuid
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  title       String                @db.VarChar(200)
  description String?
  dueDate     DateTime?             @db.Date
  status      WorkAssignmentStatus  @default(OPEN)
  createdById String?               @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions WorkSubmission[]

  @@index([employeeId, status])
  @@index([dueDate])
  @@map("work_assignments")
}

model WorkSubmission {
  id                String               @id @default(uuid()) @db.Uuid
  assignmentId      String               @db.Uuid
  assignment        WorkAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  revision          Int
  submissionText    String?
  submissionUrl     String?              @db.VarChar(500)
  status            WorkSubmissionStatus @default(SUBMITTED)
  submittedAt       DateTime             @default(now())
  reviewedAt        DateTime?
  reviewedById      String?              @db.Uuid
  reviewerFeedback  String?

  @@unique([assignmentId, revision])
  @@index([assignmentId, submittedAt])
  @@map("work_submissions")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  eventDate   DateTime  @db.Date
  eventTime   String?   @db.VarChar(5)
  color       String    @default("#f3c440") @db.VarChar(7)
  employeeId  String?   @db.Uuid
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventDate, eventTime])
  @@index([employeeId, eventDate])
  @@map("calendar_events")
}

model EmployeeNotification {
  id        String    @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  title     String    @db.VarChar(200)
  message   String
  kind      String    @db.VarChar(30)
  targetUrl String?   @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([employeeId, readAt, createdAt])
  @@map("employee_notifications")
}

// ---------------------------------------------------------------- Salary

enum ComponentType {
  EARNING
  DEDUCTION
}

enum CalculationBasis {
  /// Monthly amount configured per employee in the salary version
  FIXED
  /// Employee rate (%) applied to another component's calculated amount
  PERCENTAGE
  /// Amount entered each month in the payroll input grid
  INPUT
  /// Named, unit-tested formula from the client workbook (registry in code)
  FORMULA
}

model SalaryComponent {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique
  name              String
  type              ComponentType
  basis             CalculationBasis
  /// For PERCENTAGE: the component code the rate applies to
  percentOfCode     String?
  /// For PERCENTAGE: default rate when the employee has no specific value
  defaultPercentage Decimal?         @db.Decimal(9, 4)
  /// For INPUT: the monthly input key supplying the amount
  inputKey          String?
  /// For FORMULA: registry key of the approved formula implementation
  formulaRef        String?
  sortOrder         Int              @default(0)
  active            Boolean          @default(true)
  showOnPayslip     Boolean          @default(true)
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?          @db.Uuid
  updatedById       String?          @db.Uuid
  values            SalaryValue[]
  lines             PayrollLine[]

  @@map("salary_components")
}

/// One version of an employee's salary structure. New effective dates create a new version;
/// earlier versions are closed (effectiveTo) but never overwritten.
model SalaryVersion {
  id            String               @id @default(uuid()) @db.Uuid
  employeeId    String               @db.Uuid
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  versionNo     Int
  effectiveFrom DateTime             @db.Date
  effectiveTo   DateTime?            @db.Date
  changeReason  String?
  createdAt     DateTime             @default(now())
  createdById   String?              @db.Uuid
  values        SalaryValue[]
  runEmployees  PayrollRunEmployee[]

  @@unique([employeeId, versionNo])
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_salary_versions")
}

model SalaryValue {
  id              String          @id @default(uuid()) @db.Uuid
  salaryVersionId String          @db.Uuid
  salaryVersion   SalaryVersion   @relation(fields: [salaryVersionId], references: [id], onDelete: Restrict)
  componentId     String          @db.Uuid
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  value           Decimal         @db.Decimal(18, 4)

  @@unique([salaryVersionId, componentId])
  @@map("employee_salary_values")
}

// ---------------------------------------------------------------- Monthly payroll

enum InputDataType {
  NUMBER
  TEXT
}

/// Columns of the monthly input grid (the fields filled manually in the Excel today).
model PayrollInputDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique
  label       String
  dataType    InputDataType @default(NUMBER)
  mandatory   Boolean       @default(false)
  minValue    Decimal?      @db.Decimal(18, 4)
  maxValue    Decimal?      @db.Decimal(18, 4)
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid

  @@map("payroll_input_definitions")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  APPROVED
  FINALISED
}

model PayrollRun {
  id              String                @id @default(uuid()) @db.Uuid
  year            Int
  month           Int
  status          PayrollStatus         @default(DRAFT)
  employeeCount   Int                   @default(0)
  totalEarnings   Decimal?              @db.Decimal(18, 4)
  totalDeductions Decimal?              @db.Decimal(18, 4)
  totalNet        Decimal?              @db.Decimal(18, 4)
  /// Whether calculation rules were marked client-approved when this run was calculated
  rulesApproved   Boolean               @default(false)
  /// Hash of calculation inputs + configuration, for determinism checks
  calcHash        String?
  calculatedAt    DateTime?
  calculatedById  String?               @db.Uuid
  submittedAt     DateTime?
  submittedById   String?               @db.Uuid
  approvedAt      DateTime?
  approvedById    String?               @db.Uuid
  finalisedAt     DateTime?
  finalisedById   String?               @db.Uuid
  reopenCount     Int                   @default(0)
  notes           String?
  /// Optimistic concurrency counter, incremented on every state change
  version         Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdById     String?               @db.Uuid
  employees       PayrollRunEmployee[]
  inputs          PayrollInput[]
  lines           PayrollLine[]
  events          PayrollRunEvent[]
  payslips        Payslip[]
  anomalies       PayrollAnomaly[]
  checklist       PayrollRunChecklist[]
  reconAsBase     ReconciliationNote[]  @relation("ReconBase")
  reconAsCompare  ReconciliationNote[]  @relation("ReconCompare")

  /// One payroll run per month (business rule pending client confirmation)
  @@unique([year, month])
  @@index([status])
  @@map("payroll_runs")
}

/// Employees included in a run, with a snapshot of identity fields and results.
model PayrollRunEmployee {
  id              String         @id @default(uuid()) @db.Uuid
  payrollRunId    String         @db.Uuid
  payrollRun      PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId      String         @db.Uuid
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryVersionId String?        @db.Uuid
  salaryVersion   SalaryVersion? @relation(fields: [salaryVersionId], references: [id], onDelete: Restrict)
  employeeCode    String
  employeeName    String
  departmentName  String?
  designationName String?
  gross           Decimal?       @db.Decimal(18, 4)
  deductions      Decimal?       @db.Decimal(18, 4)
  net             Decimal?       @db.Decimal(18, 4)
  /// OK | WARNING | ERROR (missing inputs / invalid results)
  resultStatus    String         @default("PENDING")
  exceptions      Json           @default("[]")

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_run_employees")
}

/// Key/value monthly inputs per employee (designed so attendance import can be added later).
model PayrollInput {
  id           String     @id @default(uuid()) @db.Uuid
  payrollRunId String     @db.Uuid
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId   String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  inputKey     String
  value        String
  updatedAt    DateTime   @updatedAt
  updatedById  String?    @db.Uuid

  @@unique([payrollRunId, employeeId, inputKey])
  @@map("payroll_inputs")
}

/// One calculated amount per component per employee. Snapshot fields keep finalised payroll
/// independent of later master changes.
model PayrollLine {
  id            String           @id @default(uuid()) @db.Uuid
  payrollRunId  String           @db.Uuid
  payrollRun    PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId    String           @db.Uuid
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  componentId   String?          @db.Uuid
  component     SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: Restrict)
  componentCode String
  componentName String
  componentType ComponentType
  basis         CalculationBasis
  sortOrder     Int
  showOnPayslip Boolean          @default(true)
  amount        Decimal          @db.Decimal(18, 4)
  calcDetail    Json?

  @@index([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payroll_lines")
}

model PayrollRunEvent {
  id           String     @id @default(uuid()) @db.Uuid
  payrollRunId String     @db.Uuid
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  action       String
  fromStatus   String?
  toStatus     String
  reason       String?
  actorId      String?    @db.Uuid
  actorName    String?
  occurredAt   DateTime   @default(now())

  @@index([payrollRunId, occurredAt])
  @@map("payroll_run_events")
}

model Payslip {
  id            String     @id @default(uuid()) @db.Uuid
  payrollRunId  String     @db.Uuid
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId    String     @db.Uuid
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fileKey       String
  sha256        String
  sizeBytes     Int
  /// Set when the run is re-opened; a new payslip is generated after re-finalisation
  supersededAt  DateTime?
  generatedAt   DateTime   @default(now())
  generatedById String?    @db.Uuid

  @@index([payrollRunId, employeeId])
  @@map("payslips")
}

model ImportJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  fileName    String
  /// PREVIEWED | COMPLETED | PARTIAL | FAILED
  status      String
  totalRows   Int       @default(0)
  successRows Int       @default(0)
  errorRows   Int       @default(0)
  headers     Json      @default("[]")
  mapping     Json?
  rows        Json      @default("[]")
  errors      Json      @default("[]")
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  completedAt DateTime?

  @@index([createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------- Anomaly alerts (change request A)

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AnomalyStatus {
  OPEN
  REVIEWED
  /// No longer detected after a recalculation (kept for history)
  CLEARED
}

/// Explainable, rule-based alerts on a payroll run. Separate from payroll results: detection and
/// review never change runs, lines or finalised snapshots.
model PayrollAnomaly {
  id             String                @id @default(uuid()) @db.Uuid
  payrollRunId   String                @db.Uuid
  payrollRun     PayrollRun            @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId     String?               @db.Uuid
  employee       Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeCode   String?
  employeeName   String?
  componentCode  String?
  rule           String
  severity       AnomalySeverity
  /// Stable identity of the alert within a run (rule + employee + component)
  fingerprint    String
  /// Hash of the values behind the alert; a change re-opens a reviewed alert
  signature      String
  message        String
  details        Json                  @default("{}")
  status         AnomalyStatus         @default(OPEN)
  /// EXPECTED | CORRECTED | NOT_AN_ISSUE
  reviewOutcome  String?
  reviewComment  String?
  reviewedById   String?               @db.Uuid
  reviewedByName String?
  reviewedAt     DateTime?
  detectedAt     DateTime              @default(now())
  lastDetectedAt DateTime              @default(now())
  clearedAt      DateTime?
  events         PayrollAnomalyEvent[]

  @@unique([payrollRunId, fingerprint])
  @@index([payrollRunId, status])
  @@index([employeeId])
  @@map("payroll_anomalies")
}

model PayrollAnomalyEvent {
  id         String         @id @default(uuid()) @db.Uuid
  anomalyId  String         @db.Uuid
  anomaly    PayrollAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Restrict)
  /// DETECTED | REVIEWED | REOPENED | CLEARED | REDETECTED
  action     String
  comment    String?
  actorId    String?        @db.Uuid
  actorName  String?
  occurredAt DateTime       @default(now())

  @@index([anomalyId, occurredAt])
  @@map("payroll_anomaly_events")
}

// ---------------------------------------------------------------- Reconciliation (change request B)

enum ReconciliationClass {
  /// Difference is understood and correct (e.g. salary revision, bonus)
  EXPECTED
  /// Difference is wrong or unexplained and needs action
  DISCREPANCY
  /// A discrepancy that has been corrected
  RESOLVED
}

/// Explanation for a difference between two payroll runs, per employee (componentCode = "") or
/// per employee and component.
model ReconciliationNote {
  id             String              @id @default(uuid()) @db.Uuid
  baseRunId      String              @db.Uuid
  baseRun        PayrollRun          @relation("ReconBase", fields: [baseRunId], references: [id], onDelete: Restrict)
  compareRunId   String              @db.Uuid
  compareRun     PayrollRun          @relation("ReconCompare", fields: [compareRunId], references: [id], onDelete: Restrict)
  employeeId     String              @db.Uuid
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  componentCode  String              @default("")
  classification ReconciliationClass
  note           String
  createdAt      DateTime            @default(now())
  createdById    String?             @db.Uuid
  createdByName  String?
  updatedAt      DateTime            @updatedAt
  updatedById    String?             @db.Uuid
  updatedByName  String?

  @@unique([baseRunId, compareRunId, employeeId, componentCode])
  @@index([compareRunId])
  @@map("reconciliation_notes")
}

// ---------------------------------------------------------------- Knowledge & handover (change request F)

enum KnowledgeCategory {
  PROCEDURE
  COMPONENT
  BUSINESS_RULE
  VALIDATION_ERROR
  ONBOARDING
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
}

/// Current version of a knowledge article. Every save also writes an immutable version row.
model KnowledgeArticle {
  id              String                    @id @default(uuid()) @db.Uuid
  slug            String                    @unique
  category        KnowledgeCategory
  title           String
  body            String
  /// Linked salary component (COMPONENT articles)
  componentCode   String?
  /// Linked exception / validation code (VALIDATION_ERROR articles), e.g. MISSING_INPUT
  errorCode       String?
  status          KnowledgeStatus           @default(DRAFT)
  /// false = the rule depends on the client and has not been confirmed in writing
  clientConfirmed Boolean                   @default(false)
  ownerId         String?                   @db.Uuid
  ownerName       String?
  reviewDueAt     DateTime?                 @db.Date
  lastReviewedAt  DateTime?
  lastReviewedBy  String?
  currentVersion  Int                       @default(1)
  archivedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdById     String?                   @db.Uuid
  updatedById     String?                   @db.Uuid
  versions        KnowledgeArticleVersion[]
  checklistItems  ChecklistItem[]

  @@index([category])
  @@index([componentCode])
  @@index([errorCode])
  @@map("knowledge_articles")
}

model KnowledgeArticleVersion {
  id            String           @id @default(uuid()) @db.Uuid
  articleId     String           @db.Uuid
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  version       Int
  title         String
  body          String
  changeNote    String
  createdAt     DateTime         @default(now())
  createdById   String?          @db.Uuid
  createdByName String?

  @@unique([articleId, version])
  @@map("knowledge_article_versions")
}

/// Template of the monthly payroll checklist.
model ChecklistItem {
  id          String                @id @default(uuid()) @db.Uuid
  label       String
  description String?
  articleId   String?               @db.Uuid
  article     KnowledgeArticle?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  sortOrder   Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  runEntries  PayrollRunChecklist[]

  @@map("payroll_checklist_items")
}

/// Checklist progress for one payroll run.
model PayrollRunChecklist {
  id           String        @id @default(uuid()) @db.Uuid
  payrollRunId String        @db.Uuid
  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  itemId       String        @db.Uuid
  item         ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  done         Boolean       @default(false)
  note         String?
  doneById     String?       @db.Uuid
  doneByName   String?
  doneAt       DateTime?

  @@unique([payrollRunId, itemId])
  @@map("payroll_run_checklist")
}

// ---------------------------------------------------------------- Leave management

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave types and yearly allowance. Unpaid types feed the unpaid-leave payroll input when mapped.
model LeaveType {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String
  paid         Boolean            @default(true)
  /// Days per calendar year (null = no limit tracked)
  annualDays   Decimal?           @db.Decimal(6, 1)
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  requests     LeaveRequest[]
  entitlements LeaveEntitlement[]

  @@map("leave_types")
}

/// Optional per-employee override of the yearly allowance.
model LeaveEntitlement {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId String    @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  days        Decimal   @db.Decimal(6, 1)
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_entitlements")
}

/// A leave request within one calendar month (split longer leave into one request per month).
model LeaveRequest {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String      @db.Uuid
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId     String      @db.Uuid
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  /// Days counted, as entered (half days allowed); never more than the calendar span
  days            Decimal     @db.Decimal(5, 1)
  reason          String?
  status          LeaveStatus @default(REQUESTED)
  requestedById   String?     @db.Uuid
  requestedByName String?
  decidedById     String?     @db.Uuid
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
  @@map("leave_requests")
}

// ---------------------------------------------------------------- Loans and salary advances

enum LoanKind {
  LOAN
  ADVANCE
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

/// A loan or salary advance recovered through the mapped payroll input. Recoveries are read from
/// finalised payroll runs, so re-opening a run can never leave a stale repayment behind.
model Loan {
  id            String     @id @default(uuid()) @db.Uuid
  employeeId    String     @db.Uuid
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind          LoanKind
  principal     Decimal    @db.Decimal(18, 4)
  instalment    Decimal    @db.Decimal(18, 4)
  startYear     Int
  startMonth    Int
  status        LoanStatus @default(ACTIVE)
  note          String?
  closedAt      DateTime?
  closedReason  String?
  createdAt     DateTime   @default(now())
  createdById   String?    @db.Uuid
  createdByName String?
  updatedAt     DateTime   @updatedAt

  @@index([employeeId, status])
  @@map("loans")
}

// ---------------------------------------------------------------- Bonuses and incentives

enum BonusKind {
  BONUS
  INCENTIVE
}

enum BonusStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// An approved amount for one employee and payroll month. Amounts are entered, never calculated here.
model BonusEntry {
  id             String      @id @default(uuid()) @db.Uuid
  employeeId     String      @db.Uuid
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind           BonusKind
  year           Int
  month          Int
  amount         Decimal     @db.Decimal(18, 4)
  reason         String
  status         BonusStatus @default(PROPOSED)
  proposedById   String?     @db.Uuid
  proposedByName String?
  decidedById    String?     @db.Uuid
  decidedByName  String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([year, month, status])
  @@index([employeeId])
  @@map("bonus_entries")
}

/// Employee salary account. The account number is encrypted (AES-256-GCM, BANK_DATA_KEY) and is
/// only decrypted into the bank salary file; screens show the last four digits.
model EmployeeBankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @unique @db.Uuid
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  accountHolder    String
  accountNumberEnc String
  accountLast4     String
  ifsc             String
  bankName         String?
  branch           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedById      String?  @db.Uuid

  @@map("employee_bank_accounts")
}

/// One generated bank salary file (the file itself is not stored; amounts are not logged).
model BankExport {
  id            String   @id @default(uuid()) @db.Uuid
  payrollRunId  String   @db.Uuid
  format        String
  fileName      String
  employeeCount Int
  skippedCount  Int
  fileSha256    String
  createdById   String   @db.Uuid
  createdByName String
  createdAt     DateTime @default(now())

  @@index([payrollRunId])
  @@map("bank_exports")
}

/// API key for a server-to-server integration (attendance application). Only a hash is stored.
model IntegrationKey {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  prefix      String            @unique
  keyHash     String
  createdById String            @db.Uuid
  createdAt   DateTime          @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  batches     AttendanceBatch[]

  @@map("integration_keys")
}

/// Attendance data received from the attendance application for one payroll month.
model AttendanceBatch {
  id           String          @id @default(uuid()) @db.Uuid
  keyId        String?         @db.Uuid
  key          IntegrationKey? @relation(fields: [keyId], references: [id], onDelete: Restrict)
  /// Sender's batch identifier; the same identifier is accepted only once per key
  externalId   String?
  year         Int
  month        Int
  /// RECEIVED | APPLIED | PARTIAL | FAILED
  status       String          @default("RECEIVED")
  recordCount  Int
  appliedCount Int             @default(0)
  records      Json
  errors       Json            @default("[]")
  payrollRunId String?         @db.Uuid
  receivedAt   DateTime        @default(now())
  appliedAt    DateTime?
  appliedById  String?         @db.Uuid

  @@unique([keyId, externalId])
  @@index([year, month])
  @@map("attendance_batches")
}

model EmployeeWorkforceProfile {
  employeeId      String   @id @db.Uuid
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  teamsId         String?  @db.VarChar(150)
  college         String?  @db.VarChar(200)
  course          String?  @db.VarChar(150)
  internshipRole  String?  @db.VarChar(150)
  durationMonths  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("employee_workforce_profiles")
}

model EmployeeRating {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rating      Int
  feedback    String?
  ratingDate  DateTime @db.Date
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, ratingDate])
  @@index([ratingDate])
  @@map("employee_ratings")
}

enum EmployeeDocumentCategory {
  OFFER_LETTER
  PROFILE_PHOTO
  OTHER
}

model EmployeeDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  employeeId   String                  @db.Uuid
  employee     Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     EmployeeDocumentCategory
  originalName String                  @db.VarChar(255)
  storedName   String                  @unique @db.VarChar(100)
  contentType  String                  @db.VarChar(100)
  sizeBytes    Int
  uploadedById String?                 @db.Uuid
  createdAt    DateTime                @default(now())

  @@index([employeeId, category, createdAt])
  @@map("employee_documents")
}

enum ClientAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum ClientDocumentCategory {
  PHOTO
  AADHAAR
  MOU
}

model ClientRecord {
  id               String             @id @default(uuid()) @db.Uuid
  clientName       String             @db.VarChar(200)
  phoneCountryCode String?            @db.VarChar(10)
  phoneNumber      String?            @db.VarChar(30)
  country          String?            @db.VarChar(100)
  stateRegion      String?            @db.VarChar(150)
  city             String?            @db.VarChar(150)
  address          String?
  availability     ClientAvailability @default(AVAILABLE)
  availableFrom    String?            @db.VarChar(5)
  availableTo      String?            @db.VarChar(5)
  referenceEmail   String?            @db.VarChar(255)
  notes            String?
  createdById      String?            @db.Uuid
  updatedById      String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        ClientDocument[]

  @@index([clientName])
  @@index([availability])
  @@map("client_records")
}

model ClientDocument {
  id           String                 @id @default(uuid()) @db.Uuid
  clientId     String                 @db.Uuid
  client       ClientRecord           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category     ClientDocumentCategory
  originalName String                 @db.VarChar(255)
  storedName   String                 @unique @db.VarChar(100)
  contentType  String                 @db.VarChar(100)
  sizeBytes    Int
  uploadedById String?                @db.Uuid
  createdAt    DateTime               @default(now())

  @@index([clientId, category, createdAt])
  @@map("client_documents")
}
